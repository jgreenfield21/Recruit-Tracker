# Database connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/recruittrack

# Session secret (generate a random string, e.g., openssl rand -hex 32)
SESSION_SECRET=your-random-session-secret-here

# Set to "true" for local development (bypasses Replit Auth)
MOCK_AUTH=true

# Replit Auth (not needed when MOCK_AUTH=true)
# ISSUER_URL=https://replit.com/oidc
# REPL_ID=your-repl-id
# REPL_SECRET=your-repl-secret
