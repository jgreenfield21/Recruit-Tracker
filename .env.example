# Database connection (Supabase example)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Session secret (generate a random string, e.g., openssl rand -hex 32)
SESSION_SECRET=your-random-session-secret-here

# ============================================
# Authentication Options (choose one)
# ============================================

# Option 1: Mock Auth (for local development/testing)
# Set to "true" to bypass authentication entirely
MOCK_AUTH=true

# Option 2: Firebase/Google Auth (for Vercel deployment)
# Get these from Firebase Console > Project Settings > Your Apps
# FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_APP_ID=your-firebase-app-id
# VITE_FIREBASE_API_KEY=your-firebase-api-key

# Option 3: Replit Auth (automatic on Replit platform)
# These are automatically provided by Replit - no configuration needed
# ISSUER_URL=https://replit.com/oidc
# REPL_ID=your-repl-id
