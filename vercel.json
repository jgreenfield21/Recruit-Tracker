{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
